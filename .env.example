# Production compose only. Generate a long URL-safe secret, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-generated-hex-secret
# DNS hostnames without https://. Both must point to your server.
WEB_DOMAIN=crm.example.com
ADMIN_DOMAIN=admin.example.com
# To use a public IPv4 without a domain, set both values above to the same IP
# and select the IP configuration. Caddy obtains and renews a trusted certificate.
# CADDY_CONFIG=/etc/caddy/Caddyfile.ip
